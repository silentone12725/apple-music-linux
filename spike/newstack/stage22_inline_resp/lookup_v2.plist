<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>cfgs</key>
    <dict>
        <key>is-in-line-flow-supported</key>
        <true/>
        <key>2faUpgradeAccountTypePriority</key>
        <array>
            <string>itunesstore</string>
            <string>icloud</string>
            <string>imessage</string>
            <string>facetime</string>
            <string>gamecenter</string>
        </array>
        <key>abs-enable</key>
        <integer>1</integer>
        <key>appleOwnedDomains</key>
        <array>
            <string>apple.com</string>
            <string>icloud.com</string>
            <string>icloud.com.cn</string>
            <string>apple.com.cn</string>
            <string>private.icloud.com</string>
        </array>
        <key>aidc-cfgs</key>
        <dict>
            <key>threshold-getMyInfo</key>
            <integer>40</integer>
            <key>threshold-certCertificate</key>
            <integer>20</integer>
            <key>threshold-fetchCertificate</key>
            <integer>20</integer>
            <key>threshold-findPerson</key>
            <integer>40</integer>
        </dict>
        <key>metrics-performance</key>
        <dict>
            <key>samplingPercentageCachedResponses</key>
            <real>1.0</real>
            <key>sessionDuration</key>
            <integer>60000</integer>
            <key>samplingPercentageUsers</key>
            <real>0.9</real>
        </dict>
        <key>baaHeaders</key>
        <array>
            <string>X-MMe-Client-Info</string>
        </array>
        <key>is-phone-number-supported</key>
        <false/>
        <key>disablePSCreateAndForgetLink</key>
        <true/>
        <key>appleIDAuthorizationUrls</key>
        <array>
            <string>https://appleid.apple.com/auth/authorize</string>
            <string>https://idmsa.apple.com/appleauth/auth/authorize/signin</string>
            <string>https://idmsa.apple.com.cn/appleauth/auth/authorize/signin</string>
        </array>
    </dict>
    <key>env</key>
    <dict>
        <key>apsEnv</key>
        <string>production</string>
        <key>idmsEnv</key>
        <string>IdMS</string>
    </dict>
    <key>urls</key>
    <dict>
        <key>postData</key>
        <dict>
            <key>url</key>
            <string>https://gsd.apple.com/grandslam/GsService2/postdata</string>
        </dict>
        <key>signout</key>
        <dict>
            <key>url</key>
            <string>https://gsd.apple.com/grandslam/ws/device/signout</string>
        </dict>
        <key>gsService</key>
        <dict>
            <key>url</key>
            <string>https://gsd.apple.com/grandslam/GsService2</string>
        </dict>
        <key>tokenUpgrade</key>
        <dict>
            <key>url</key>
            <string>https://gsd.apple.com/grandslam/GsService2/tokenupgrade</string>
        </dict>
        <key>secondaryAuth</key>
        <dict>
            <key>url</key>
            <string>https://gsd.apple.com/auth</string>
        </dict>
        <key>midSyncMachine</key>
        <dict>
            <key>url</key>
            <string>https://gsd.apple.com/grandslam/MidService/syncMachine</string>
        </dict>
        <key>trustedDeviceSecondaryAuth</key>
        <dict>
            <key>url</key>
            <string>https://gsd.apple.com/auth/verify/trusteddevice</string>
        </dict>
        <key>fetchUserInfo</key>
        <dict>
            <key>url</key>
            <string>https://gsd.apple.com/grandslam/GsService2/fetchUserInfo</string>
        </dict>
        <key>launchSignIn</key>
        <dict>
            <key>url</key>
            <string>https://gsd.apple.com/auth/container/signin</string>
        </dict>
        <key>midFinishProvisioning</key>
        <dict>
            <key>baa</key>
            <integer>1</integer>
            <key>url</key>
            <string>https://gsd.apple.com/grandslam/MidService/finishMachineProvisioning</string>
        </dict>
        <key>validateCode</key>
        <dict>
            <key>url</key>
            <string>https://gsa.apple.com/grandslam/GsService2/validate</string>
        </dict>
        <key>midStartProvisioning</key>
        <dict>
            <key>baa</key>
            <integer>1</integer>
            <key>url</key>
            <string>https://gsd.apple.com/grandslam/MidService/startMachineProvisioning</string>
        </dict>
    </dict>
</dict>
</plist>
