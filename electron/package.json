{
  "name": "apple-music-linux",
  "version": "1.4.0",
  "description": "Apple Music desktop client for Linux",
  "license": "MIT",
  "main": "main.mjs",
  "type": "module",
  "engines": {
    "electron": "^43.0.0"
  },
  "dependencies": {
    "mpris-service": "^2.1.2",
    "x11": "^2.3.0"
  },
  "allowScripts": {
    "abstract-socket@2.1.1": true
  },
  "scripts": {
    "dist": "npm run build:drm && npm run build:go && npm run build:engine && npm run build:vlc && electron-builder --linux AppImage",
    "postdist": "rm -f dist/builder-debug.yml dist/builder-effective-config.yaml",
    "clean": "bash ../scripts/clean.sh",
    "build:drm": "make -C ../drm libdrm_client.so",
    "build:engine": "bash ../scripts/build-renderer.sh",
    "build:go": "bash ../scripts/build-engine.sh dist/resources",
    "build:vlc": "bash ../scripts/bundle-vlc.sh"
  },
  "desktopName": "apple-music-linux.desktop",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "mp4box": "^2.4.1"
  },
  "build": {
    "appId": "com.apple.android.music",
    "productName": "Apple Music",
    "copyright": "Apple Inc.",
    "files": [
      "**/*",
      "!node_modules/.bin",
      "!**/*.map",
      "!test-*.html",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "dist/resources/engine",
        "to": "engine"
      },
      {
        "from": "dist/resources/libdrm_client.so",
        "to": "libdrm_client.so"
      },
      {
        "from": "../drm/libhybris-core.so",
        "to": "libhybris-core.so"
      },
      {
        "from": "../drm/hybris-linker",
        "to": "hybris-linker"
      },
      {
        "from": "../drm/rootfs",
        "to": "rootfs",
        "filter": [
          "system/**",
          "etc/**"
        ]
      },
      {
        "from": "dist/resources/vlc",
        "to": "vlc"
      },
      {
        "from": "../assets/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "AudioVideo",
      "description": "Apple Music desktop client for Linux",
      "executableName": "apple-music-linux",
      "artifactName": "apple-music-linux.AppImage",
      "syncDesktopName": true,
      "mimeTypes": [
        "x-scheme-handler/aml"
      ]
    }
  }
}
